# Multi-stage build for ASCILI Rust Video Engine
FROM rust:1.82-bookworm AS builder

WORKDIR /app
COPY rust_video_engine ./rust_video_engine

WORKDIR /app/rust_video_engine
RUN cargo build --release

# Runtime stage with FFmpeg
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/rust_video_engine/target/release/rust_video_engine /usr/local/bin/rust_video_engine

RUN mkdir -p /app/converted_videos /app/uploaded_videos

EXPOSE 8000

ENV PORT=8000

CMD ["rust_video_engine", "--serve", "--port", "8000"]
